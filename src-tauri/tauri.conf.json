{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quaestio Client",
  "version": "0.7.6",
  "identifier": "it.arcieri.quaestio.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quaestio Client",
        "width": 1000,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Education",
    "shortDescription": "Client open source per questionari controllati Quaestio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian"
        ],
        "displayLanguageSelector": false
      }
    },
    "longDescription": "Strumento tecnico-didattico e di ricerca ideato e sviluppato da Franco Arcieri.",
    "copyright": "Copyright © 2022–2026 Franco Arcieri",
    "publisher": "Franco Arcieri"
  }
}
